{
  "schema_version": 1,
  "fixture_name": "buildroot_text_evidence_mini",
  "fixture_root": "fixtures/buildroot_text_evidence_mini",
  "purpose": "Deterministic Buildroot-style Stage 0 text-evidence fixture gate before broad behavior implementation.",
  "scope": {
    "should_be_scoped": true,
    "must_not_create_db_in_fixture": true,
    "normal_in_repo_codegraph_db_allowed": false
