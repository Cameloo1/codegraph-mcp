  "evidence_contract": {
    "text_evidence_proves": [
      "this text exists",
      "in this file",
      "at this line/span",
      "matching this token/query/snippet"
    ],
    "text_evidence_does_not_prove": [
      "CALLS",
      "READS",
      "WRITES",
      "FLOWS_TO",
      "MUTATES",
      "TESTS",
      "ASSERTS",
      "any typed graph relation"
    ],
    "text_evidence_default_proof_status": "not_graph_proof",
    "fallback_no_proof_status": "no_proof_path_found"
  },
  "files": [
    {
      "path": "package/foo/foo.mk",
      "fixture_role": "buildroot_package_makefile",
      "expected_evidence_kind": "text_evidence",
      "expected_evidence_role": "text_evidence",
      "expected_proof_status": "not_graph_proof",
      "expected_source_file_kind": "makefile_fragment",
      "expected_tokens": [
        "FOO_VERSION",
        "FOO_SITE",
        "FOO_LICENSE",
        "FOO_DEPENDENCIES",
        "generic-package"
      ],
      "expected_source_spans": [
        { "token": "FOO_VERSION", "start_line": 7, "end_line": 7 },
        { "token": "FOO_SITE", "start_line": 8, "end_line": 8 },
        { "token": "FOO_LICENSE", "start_line": 9, "end_line": 10 },
        { "token": "FOO_DEPENDENCIES", "start_line": 11, "end_line": 11 },
        { "token": "generic-package", "start_line": 13, "end_line": 13 }
