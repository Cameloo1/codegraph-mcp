{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://codegraph.local/schemas/agent-json/doctor_compact_json.schema.json",
  "title": "doctor_compact_json",
  "type": "object",
  "required": [
    "schema_name",
    "schema_version",
    "status",
    "command",
    "repo",
    "db",
    "lifecycle",
    "claimable",
    "diagnostic_only",
    "truncation",
    "result_count",
    "limit",
    "omitted_count",
    "warnings",
    "errors",
    "timings"
  ],
  "additionalProperties": true,
  "properties": {
    "schema_name": {
      "const": "doctor_compact_json"
    },
    "schema_version": {
      "const": 1
    },
    "status": {
      "$ref": "common.schema.json#/$defs/status"
    },
    "command": {
      "const": "doctor"
    },
    "repo": {
      "$ref": "common.schema.json#/$defs/repo"
    },
    "db": {
      "$ref": "common.schema.json#/$defs/db"
    },
    "lifecycle": {
      "$ref": "common.schema.json#/$defs/lifecycle_summary"
    },
    "claimable": {
      "type": "boolean"
    },
    "diagnostic_only": {
      "type": "boolean"
    },
    "truncation": {
      "$ref": "common.schema.json#/$defs/truncation"
    },
    "result_count": {
      "const": 1
    },
    "limit": {
      "const": 1
    },
    "omitted_count": {
      "const": 0
    },
    "warnings": {
      "$ref": "common.schema.json#/$defs/bounded_messages"
    },
    "errors": {
      "$ref": "common.schema.json#/$defs/bounded_messages"
    },
    "timings": {
      "$ref": "common.schema.json#/$defs/timings"
    },
    "dirty_evidence_summary": {
      "$ref": "common.schema.json#/$defs/dirty_evidence_summary"
    },
    "stale_evidence": {
      "$ref": "common.schema.json#/$defs/dirty_evidence_surface_status_list"
    },
    "unavailable_evidence": {
      "$ref": "common.schema.json#/$defs/dirty_evidence_surface_status_list"
    },
    "claimability_effect": {
      "$ref": "common.schema.json#/$defs/dirty_evidence_claimability_effect"
    },
    "candidate_layer_status": {
      "$ref": "common.schema.json#/$defs/dirty_evidence_freshness_state"
    },
    "vector_layer_status": {
      "$ref": "common.schema.json#/$defs/dirty_evidence_freshness_state"
    },
    "path_evidence_status": {
      "$ref": "common.schema.json#/$defs/dirty_evidence_freshness_state"
    },
    "source_navigation_status": {
      "$ref": "common.schema.json#/$defs/dirty_evidence_freshness_state"
    },
    "routing_handle_status": {
      "$ref": "common.schema.json#/$defs/dirty_evidence_freshness_state"
    },
    "sidecar_statuses": {
      "$ref": "common.schema.json#/$defs/sidecar_statuses"
    },
    "recovery_commands": {
      "$ref": "common.schema.json#/$defs/recovery_commands"
    },
    "stale_non_proof_reasons": {
      "$ref": "common.schema.json#/$defs/stale_non_proof_reasons"
    },
    "telemetry": {
      "$ref": "common.schema.json#/$defs/telemetry_truth"
    }
  }
}
