{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://codegraph.local/schemas/agent-json/context_pack_agent_json.schema.json",
  "title": "context_pack_agent_json",
  "type": "object",
  "required": [
    "schema_name",
    "schema_version",
    "status",
    "command",
    "repo",
    "db",
    "lifecycle",
    "claimable",
    "diagnostic_only",
    "truncation",
    "result_count",
    "limit",
    "omitted_count",
    "warnings",
    "errors",
    "timings",
    "task",
    "mode",
    "symbols",
    "paths",
    "snippets"
  ],
  "additionalProperties": true,
  "properties": {
    "schema_name": {
      "const": "context_pack_agent_json"
    },
    "schema_version": {
      "const": 1
    },
    "status": {
      "$ref": "common.schema.json#/$defs/status"
    },
    "command": {
      "const": "context-pack"
    },
    "repo": {
      "$ref": "common.schema.json#/$defs/repo"
    },
    "db": {
      "$ref": "common.schema.json#/$defs/db"
    },
    "lifecycle": {
      "$ref": "common.schema.json#/$defs/lifecycle_summary"
    },
    "claimable": {
      "type": "boolean"
    },
    "diagnostic_only": {
      "type": "boolean"
    },
    "truncation": {
      "$ref": "common.schema.json#/$defs/truncation"
    },
    "result_count": {
      "type": "integer",
      "minimum": 0
    },
    "limit": {
      "type": "integer",
      "minimum": 0
    },
    "omitted_count": {
      "type": "integer",
      "minimum": 0
    },
    "warnings": {
      "$ref": "common.schema.json#/$defs/bounded_messages"
    },
    "errors": {
      "$ref": "common.schema.json#/$defs/bounded_messages"
    },
    "timings": {
      "$ref": "common.schema.json#/$defs/timings"
    },
    "task": {
      "type": "string"
    },
    "mode": {
      "type": "string"
    },
    "symbols": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "paths": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "path_id",
          "evidence_role",
          "production_proof_eligible",
          "relations",
          "edges",
          "source_spans"
        ],
        "additionalProperties": true,
        "properties": {
          "path_id": {
            "type": "string"
          },
          "summary": {
            "type": "string"
          },
          "evidence_role": {
            "$ref": "common.schema.json#/$defs/evidence_role"
          },
          "classification_reason": {
            "type": "string"
          },
          "classification_source": {
            "type": "string"
          },
          "production_proof_eligible": {
            "type": "boolean"
          },
          "relations": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "edges": {
            "type": "array",
            "items": {
              "$ref": "common.schema.json#/$defs/proof_edge"
            }
          },
          "source_spans": {
            "type": "array",
            "items": {
              "$ref": "common.schema.json#/$defs/source_span"
            }
          }
        }
      }
    },
    "proof_path_available": {
      "type": "boolean"
    },
    "proof_path_count": {
      "type": "integer",
      "minimum": 0
    },
    "fallback_evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "symbol",
          "kind",
          "file",
          "source_span",
          "evidence_role",
          "classification_reason",
          "classification_source",
          "fallback_source",
          "proof_path_available"
        ],
        "additionalProperties": true,
        "properties": {
          "id": {
            "type": "string"
          },
          "symbol": {
            "type": "string"
          },
          "kind": {
            "type": "string"
          },
          "file": {
            "type": "string"
          },
          "source_span": {
            "$ref": "common.schema.json#/$defs/source_span"
          },
          "span": {
            "$ref": "common.schema.json#/$defs/source_span"
          },
          "evidence_role": {
            "$ref": "common.schema.json#/$defs/evidence_role"
          },
          "classification_reason": {
            "type": "string"
          },
          "classification_source": {
            "type": "string"
          },
          "fallback_source": {
            "type": "string"
          },
          "proof_path_available": {
            "const": false
          }
        }
      }
    },
    "fallback_evidence_count": {
      "type": "integer",
      "minimum": 0
    },
    "graph_verification": {
      "type": "object",
      "required": [
        "status",
        "candidate_count",
        "proof_status",
        "graph_proof",
        "evidence_status",
        "fallback_evidence_count",
        "reason",
        "proof_failure_reason",
        "contract"
      ],
      "additionalProperties": true,
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "graph_verified",
            "no_proof_path_found",
            "no_graph_candidates",
            "unknown"
          ]
        },
        "candidate_count": {
          "type": "integer",
          "minimum": 0
        },
        "proof_status": {
          "$ref": "common.schema.json#/$defs/retrieval_proof_status"
        },
        "graph_proof": {
          "type": "boolean"
        },
        "evidence_status": {
          "type": "string"
        },
        "fallback_evidence_count": {
          "type": "integer",
          "minimum": 0
        },
        "text_only_candidates_require_graph_verification": {
          "const": false
        },
        "source_text_fallback_available": {
          "type": "boolean"
        },
        "reason": {
          "type": "string"
        },
        "proof_failure_reason": {
          "type": ["string", "null"]
        },
        "contract": {
          "type": "object",
          "additionalProperties": true
        }
      }
    },
    "proof_failure_reason": {
      "type": ["string", "null"]
    },
    "candidates": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/retrieval_candidate"
      }
    },
    "candidate_count": {
      "type": "integer",
      "minimum": 0
    },
    "candidate_total_count": {
      "type": "integer",
      "minimum": 0
    },
    "candidate_omitted_count": {
      "type": "integer",
      "minimum": 0
    },
    "candidate_omitted_reason": {
      "type": "string"
    },
    "candidate_cap": {
      "type": "integer",
      "minimum": 1
    },
    "candidate_cap_policy": {
      "type": "string"
    },
    "candidate_exact_seed_cap_override": {
      "type": "boolean"
    },
    "retrieval_architecture": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "schema_version": {
          "const": 1
        },
        "contract": {
          "type": "string"
        },
        "current_phase_scope": {
          "type": "string"
        },
        "proof_status": {
          "type": "string"
        },
        "graph_proof": {
          "type": "boolean"
        },
        "evidence_status": {
          "type": "string"
        },
        "graph_verification": {
          "type": "object",
          "additionalProperties": true
        },
        "prompt_intent": {
          "$ref": "common.schema.json#/$defs/prompt_intent"
        },
        "prompt_seed_provenance": {
          "type": "array",
          "maxItems": 12,
          "items": {
            "$ref": "common.schema.json#/$defs/prompt_seed_provenance"
          }
        },
        "candidate_flow": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["stage", "status", "proof_contract"],
            "additionalProperties": true,
            "properties": {
              "stage": {
                "type": "string"
              },
              "status": {
                "type": "string"
              },
              "proof_contract": {
                "type": "string"
              }
            }
          }
        },
        "inactive_lanes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "retrieval_explain": {
      "type": "object",
      "required": [
        "schema_version",
        "diagnostic_only",
        "trigger",
        "prompt_intent",
        "seeds_extracted",
        "ignored_seeds",
        "candidate_sources",
        "candidate_counts_by_source",
        "candidate_caps",
        "dedup_results",
        "ranking_reasons",
        "graph_verification_attempts",
        "traversal_mode",
        "relation_allowlist",
        "source_role_filter",
        "candidate_sources_verified",
        "path_evidence_lookup_time_ms",
        "path_evidence_hydration_time_ms",
        "traversal_telemetry",
        "path_evidence_telemetry",
        "proof_paths_found",
        "no_proof_fallback_reason",
        "omitted_count",
        "omitted_counts"
      ],
      "additionalProperties": true,
      "properties": {
        "schema_version": {
          "const": 1
        },
        "diagnostic_only": {
          "const": true
        },
        "trigger": {
          "type": "string"
        },
        "prompt_intent": {
          "$ref": "common.schema.json#/$defs/prompt_intent"
        },
        "seeds_extracted": {
          "type": "array",
          "items": {
            "$ref": "common.schema.json#/$defs/prompt_seed_provenance"
          }
        },
        "ignored_seeds": {
          "type": "array",
          "items": {
            "$ref": "common.schema.json#/$defs/prompt_seed_provenance"
          }
        },
        "candidate_sources": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "candidate_counts_by_source": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          }
        },
        "candidate_caps": {
          "type": "object",
          "additionalProperties": true
        },
        "dedup_results": {
          "type": "object",
          "additionalProperties": true
        },
        "ranking_reasons": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": true
          }
        },
        "graph_verification_attempts": {
          "type": "object",
          "additionalProperties": true
        },
        "traversal_mode": {
          "type": "string"
        },
        "relation_allowlist": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "source_role_filter": {
          "type": "object",
          "additionalProperties": true
        },
        "candidate_sources_verified": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "path_evidence_lookup_time_ms": {
          "type": ["number", "null"]
        },
        "path_evidence_hydration_time_ms": {
          "type": ["number", "null"]
        },
        "traversal_telemetry": {
          "type": "object",
          "additionalProperties": true
        },
        "path_evidence_telemetry": {
          "type": "object",
          "additionalProperties": true
        },
        "vector_trace": {
          "type": ["object", "null"],
          "additionalProperties": true
        },
        "nuance_rescue_trace": {
          "type": ["object", "null"],
          "additionalProperties": true
        },
        "proof_paths_found": {
          "type": "integer",
          "minimum": 0
        },
        "no_proof_fallback_reason": {
          "type": ["string", "null"]
        },
        "omitted_count": {
          "type": "integer",
          "minimum": 0
        },
        "omitted_counts": {
          "type": "object",
          "additionalProperties": true
        }
      }
    },
    "snippets": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/snippet"
      }
    },
    "recommended_tests": {
      "type": "array",
      "maxItems": 12,
      "items": {
        "type": "string"
      }
    },
    "risks": {
      "type": "array",
      "maxItems": 12,
      "items": {
        "type": "string"
      }
    }
  }
}
