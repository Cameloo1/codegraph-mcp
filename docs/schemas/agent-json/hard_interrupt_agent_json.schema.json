{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://codegraph.local/schemas/agent-json/hard_interrupt_agent_json.schema.json",
  "title": "hard_interrupt_agent_json",
  "type": "object",
  "required": [
    "schema_version",
    "packet_kind",
    "status",
    "must_fix_before_continuing",
    "hard_interrupt_available",
    "changed_files",
    "source_validation_packet_kind",
    "errors",
    "warnings",
    "unknowns",
    "diagnostics",
    "error_count",
    "warnings_summary",
    "unknowns_summary",
    "diagnostics_summary",
    "summary",
    "claimability",
    "lifecycle",
    "proof_ladder_changes",
    "stale_unsafe_blockers",
    "validation_rules_evaluated",
    "validation_rules_skipped",
    "omitted_count",
    "expansion_handles",
    "generated_at"
  ],
  "anyOf": [
    {
      "required": ["source_validation_packet_ref"]
    },
    {
      "required": ["source_validation_packet_summary"]
    }
  ],
  "additionalProperties": true,
  "properties": {
    "schema_version": {
      "const": 1
    },
    "packet_kind": {
      "const": "hard_interrupt"
    },
    "status": {
      "const": "blocking_graph_error"
    },
    "must_fix_before_continuing": {
      "const": true
    },
    "hard_interrupt_available": {
      "const": true
    },
    "changed_files": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "source_validation_packet_ref": {
      "type": ["string", "null"],
      "minLength": 1
    },
    "source_validation_packet_summary": {
      "type": ["object", "null"],
      "additionalProperties": true
    },
    "source_validation_packet_kind": {
      "const": "graph_validation_packet"
    },
    "errors": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/hard_interrupt_error"
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/interrupt_source_finding"
      }
    },
    "unknowns": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/interrupt_source_finding"
      }
    },
    "diagnostics": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/interrupt_source_finding"
      }
    },
    "error_count": {
      "type": "integer",
      "minimum": 1
    },
    "warnings_summary": {
      "$ref": "#/$defs/interrupt_source_findings_summary"
    },
    "unknowns_summary": {
      "$ref": "#/$defs/interrupt_source_findings_summary"
    },
    "diagnostics_summary": {
      "$ref": "#/$defs/interrupt_source_findings_summary"
    },
    "summary": {
      "$ref": "#/$defs/interrupt_packet_summary"
    },
    "claimability": {
      "type": "object",
      "additionalProperties": true
    },
    "lifecycle": {
      "type": "object",
      "additionalProperties": true
    },
    "proof_ladder_changes": {
      "type": "object",
      "additionalProperties": true
    },
    "stale_unsafe_blockers": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "validation_rules_evaluated": {
      "type": "array",
      "items": {
        "$ref": "validation_packet_agent_json.schema.json#/$defs/validation_rule"
      }
    },
    "validation_rules_skipped": {
      "type": "array",
      "items": {
        "$ref": "validation_packet_agent_json.schema.json#/$defs/validation_rule"
      }
    },
    "aggregate_counts": {
      "$ref": "#/$defs/hard_interrupt_aggregate_counts"
    },
    "omitted_count": {
      "type": "integer",
      "minimum": 0
    },
    "expansion_handles": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/interrupt_expansion_handle"
      }
    },
    "generated_at": {
      "type": "string",
      "minLength": 1
    }
  },
  "$defs": {
    "source_span": {
      "$ref": "validation_packet_agent_json.schema.json#/$defs/source_span"
    },
    "interrupt_eligibility": {
      "type": "object",
      "required": [
        "eligible",
        "reason",
        "disqualifiers",
        "lifecycle_ok",
        "claimability_ok",
        "classification_ok",
        "reverified_graph_source_proof",
        "source_span_ok",
        "source_role_ok",
        "provenance_ok",
        "evidence_kind_ok"
      ],
      "additionalProperties": true,
      "properties": {
        "eligible": {
          "type": "boolean"
        },
        "reason": {
          "type": "string"
        },
        "disqualifiers": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "lifecycle_ok": {
          "type": "boolean"
        },
        "claimability_ok": {
          "type": "boolean"
        },
        "classification_ok": {
          "type": "boolean"
        },
        "reverified_graph_source_proof": {
          "type": "boolean"
        },
        "source_span_ok": {
          "type": "boolean"
        },
        "source_role_ok": {
          "type": "boolean"
        },
        "provenance_ok": {
          "type": "boolean"
        },
        "evidence_kind_ok": {
          "type": "boolean"
        }
      }
    },
    "interrupt_fix_hint": {
      "type": "object",
      "required": [
        "recommended_fix",
        "suggested_next_steps"
      ],
      "additionalProperties": true,
      "properties": {
        "recommended_fix": {
          "type": "string",
          "minLength": 1
        },
        "suggested_next_steps": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "interrupt_expansion_handle": {
      "type": "object",
      "required": [
        "handle",
        "target",
        "reason"
      ],
      "additionalProperties": true,
      "properties": {
        "handle": {
          "type": "string",
          "minLength": 1
        },
        "target": {
          "type": "string",
          "minLength": 1
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "interrupt_source_finding": {
      "type": "object",
      "required": [
        "finding_id",
        "validation_rule_id",
        "classification",
        "blocking_level",
        "file",
        "source_span",
        "relation_kind",
        "integrity_kind",
        "reason",
        "recommended_fix",
        "suggested_next_steps",
        "expansion_handle"
      ],
      "additionalProperties": true,
      "properties": {
        "finding_id": {
          "type": "string",
          "minLength": 1
        },
        "validation_rule_id": {
          "type": "string",
          "minLength": 1
        },
        "classification": {
          "$ref": "validation_packet_agent_json.schema.json#/$defs/validation_classification"
        },
        "blocking_level": {
          "$ref": "validation_packet_agent_json.schema.json#/$defs/validation_blocking_level"
        },
        "file": {
          "type": ["string", "null"]
        },
        "source_span": {
          "anyOf": [
            {
              "$ref": "#/$defs/source_span"
            },
            {
              "type": "null"
            }
          ]
        },
        "relation_kind": {
          "type": ["string", "null"]
        },
        "integrity_kind": {
          "type": ["string", "null"]
        },
        "reason": {
          "type": "string"
        },
        "recommended_fix": {
          "type": ["string", "null"]
        },
        "suggested_next_steps": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "expansion_handle": {
          "type": ["string", "null"]
        }
      }
    },
    "interrupt_source_findings_summary": {
      "type": "object",
      "required": [
        "count",
        "top",
        "omitted_count",
        "counts_by_validation_rule_id",
        "counts_by_relation_kind",
        "counts_by_file"
      ],
      "additionalProperties": true,
      "properties": {
        "count": {
          "type": "integer",
          "minimum": 0
        },
        "top": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/interrupt_source_finding"
          }
        },
        "omitted_count": {
          "type": "integer",
          "minimum": 0
        },
        "counts_by_validation_rule_id": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          }
        },
        "counts_by_relation_kind": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          }
        },
        "counts_by_file": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "hard_interrupt_aggregate_counts": {
      "type": "object",
      "required": [
        "by_validation_rule_id",
        "by_relation_kind",
        "by_file"
      ],
      "additionalProperties": true,
      "properties": {
        "by_validation_rule_id": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          }
        },
        "by_relation_kind": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          }
        },
        "by_file": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "hard_interrupt_error": {
      "type": "object",
      "required": [
        "validation_rule_id",
        "classification",
        "blocking_level",
        "relation_kind",
        "integrity_kind",
        "file",
        "source_span",
        "symbol",
        "source_symbol_summary",
        "target",
        "missing_target_summary",
        "message",
        "exact_proof_reason",
        "reverified_graph_source_proof",
        "claimability",
        "lifecycle",
        "recommended_fix",
        "suggested_next_steps",
        "expansion_handle"
      ],
      "additionalProperties": true,
      "properties": {
        "error_id": {
          "type": "string",
          "minLength": 1
        },
        "validation_rule_id": {
          "type": "string",
          "minLength": 1
        },
        "source_finding_id": {
          "type": "string",
          "minLength": 1
        },
        "classification": {
          "const": "block"
        },
        "blocking_level": {
          "const": "blocking"
        },
        "rule_kind": {
          "$ref": "validation_packet_agent_json.schema.json#/$defs/validation_rule_kind"
        },
        "relation_kind": {
          "type": ["string", "null"]
        },
        "integrity_kind": {
          "type": ["string", "null"]
        },
        "invariant": {
          "type": "string",
          "minLength": 1
        },
        "severity": {
          "$ref": "validation_packet_agent_json.schema.json#/$defs/final_validation_status"
        },
        "file": {
          "type": "string",
          "minLength": 1
        },
        "source_span": {
          "$ref": "#/$defs/source_span"
        },
        "symbol": {
          "type": ["string", "null"]
        },
        "source_symbol_summary": {
          "type": ["object", "null"],
          "additionalProperties": true
        },
        "target": {
          "type": ["string", "null"]
        },
        "missing_target_summary": {
          "type": ["object", "null"],
          "additionalProperties": true
        },
        "message": {
          "type": "string",
          "minLength": 1
        },
        "template_kind": {
          "type": "string",
          "minLength": 1
        },
        "exact_proof_reason": {
          "type": "string",
          "minLength": 1
        },
        "reverified_graph_source_proof": {
          "const": true
        },
        "source_role": {
          "type": ["string", "null"]
        },
        "exactness": {
          "type": ["string", "null"]
        },
        "provenance": {
          "type": ["object", "array", "string", "number", "boolean", "null"]
        },
        "claimability": {
          "type": "object",
          "additionalProperties": true
        },
        "lifecycle": {
          "type": "object",
          "additionalProperties": true
        },
        "proof_strength": {
          "type": "string",
          "minLength": 1
        },
        "proof_status": {
          "type": "string",
          "minLength": 1
        },
        "recommended_fix": {
          "type": "string",
          "minLength": 1
        },
        "suggested_next_steps": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "evidence_items": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": true
          }
        },
        "expansion_handle": {
          "$ref": "#/$defs/interrupt_expansion_handle"
        },
        "eligibility": {
          "$ref": "#/$defs/interrupt_eligibility"
        },
        "fix_hint": {
          "$ref": "#/$defs/interrupt_fix_hint"
        }
      }
    },
    "interrupt_packet_summary": {
      "type": "object",
      "required": [
        "error_count",
        "warning_count",
        "unknown_count",
        "diagnostic_count",
        "top_error_validation_rule_id",
        "top_error_file",
        "top_error_source_span",
        "top_error_recommended_fix",
        "top_error_suggested_next_steps",
        "critical_safety_fields_preserved"
      ],
      "additionalProperties": true,
      "properties": {
        "error_count": {
          "type": "integer",
          "minimum": 1
        },
        "warning_count": {
          "type": "integer",
          "minimum": 0
        },
        "unknown_count": {
          "type": "integer",
          "minimum": 0
        },
        "diagnostic_count": {
          "type": "integer",
          "minimum": 0
        },
        "top_error_validation_rule_id": {
          "type": ["string", "null"]
        },
        "top_error_file": {
          "type": ["string", "null"]
        },
        "top_error_source_span": {
          "anyOf": [
            {
              "$ref": "#/$defs/source_span"
            },
            {
              "type": "null"
            }
          ]
        },
        "top_error_recommended_fix": {
          "type": ["string", "null"]
        },
        "top_error_suggested_next_steps": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "critical_safety_fields_preserved": {
          "type": "boolean"
        }
      }
    }
  }
}
