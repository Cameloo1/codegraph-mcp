{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://codegraph.local/schemas/agent-json/common.schema.json",
  "title": "CodeGraph Agent JSON common definitions",
  "$defs": {
    "status": {
      "type": "string",
      "enum": ["ok", "warning", "error"]
    },
    "command": {
      "type": "string",
      "minLength": 1,
      "maxLength": 96
    },
    "repo": {
      "type": "string",
      "minLength": 1
    },
    "db": {
      "type": "string",
      "minLength": 1
    },
    "timings": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "wall_ms": {
          "type": "number",
          "minimum": 0
        },
        "available": {
          "type": "boolean"
        }
      }
    },
    "bounded_messages": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "type": "object",
        "required": ["code", "message"],
        "additionalProperties": true,
        "properties": {
          "code": {
            "type": "string",
            "minLength": 1,
            "maxLength": 96
          },
          "message": {
            "type": "string",
            "minLength": 1,
            "maxLength": 600
          },
          "severity": {
            "type": "string",
            "enum": ["info", "warning", "error"]
          }
        }
      }
    },
    "lifecycle_summary": {
      "type": "object",
      "required": ["claimable", "diagnostic_only"],
      "additionalProperties": true,
      "properties": {
        "claimable": {
          "type": "boolean"
        },
        "claimable_for_text": {
          "type": "boolean"
        },
        "claimable_for_graph": {
          "type": "boolean"
        },
        "diagnostic_only": {
          "type": "boolean"
        },
        "decision": {
          "type": "string"
        },
        "db_problem_kind": {
          "type": "string"
        },
        "passport_status": {
          "type": "string"
        },
        "schema_status": {
          "type": "string"
        },
        "scope_status": {
          "type": "string"
        },
        "repo_root_status": {
          "type": "string"
        },
        "sidecar_status": {
          "type": "string"
        }
      }
    },
    "truncation": {
      "type": "object",
      "required": [
        "returned_count",
        "limit_applied",
        "omitted_count",
        "total_available_unknown"
      ],
      "additionalProperties": true,
      "properties": {
        "returned_count": {
          "type": "integer",
          "minimum": 0
        },
        "limit": {
          "type": "integer",
          "minimum": 0
        },
        "limit_applied": {
          "type": "boolean"
        },
        "omitted_count": {
          "type": "integer",
          "minimum": 0
        },
        "omitted_count_is_lower_bound": {
          "type": "boolean"
        },
        "total_available": {
          "type": "integer",
          "minimum": 0
        },
        "total_available_unknown": {
          "type": "boolean"
        }
      }
    },
    "source_span": {
      "type": "object",
      "required": ["file", "start_line", "end_line"],
      "additionalProperties": true,
      "properties": {
        "file": {
          "type": "string",
          "minLength": 1
        },
        "start_line": {
          "type": "integer",
          "minimum": 1
        },
        "end_line": {
          "type": "integer",
          "minimum": 1
        },
        "start_column": {
          "type": "integer",
          "minimum": 1
        },
        "end_column": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "prompt_intent": {
      "type": "string",
      "enum": [
        "entity_lookup",
        "file_lookup",
        "text_config_lookup",
        "build_system_planning",
        "behavior_trace",
        "caller_callee_trace",
        "test_impact",
        "dataflow_trace",
        "security_auth_trace",
        "docs_text",
        "unknown"
      ]
    },
    "prompt_seed_provenance": {
      "type": "object",
      "required": [
        "seed",
        "seed_kind",
        "source_text",
        "intent_contribution",
        "exactness"
      ],
      "additionalProperties": true,
      "properties": {
        "seed": {
          "type": "string"
        },
        "seed_kind": {
          "type": "string",
          "enum": [
            "symbol",
            "file_path",
            "line_number",
            "stack_trace",
            "test_name",
            "diagnostic",
            "code_identifier",
            "config_token",
            "file_pattern",
            "path_token",
            "text_token",
            "task_verb_ignored",
            "unknown"
          ]
        },
        "source_text": {
          "type": "string"
        },
        "intent_contribution": {
          "$ref": "#/$defs/prompt_intent"
        },
        "exactness": {
          "type": "string",
          "enum": ["exact", "literal_text", "heuristic", "ignored", "unknown"]
        },
        "ignored_reason": {
          "type": ["string", "null"]
        },
        "file_path": {
          "type": ["string", "null"]
        },
        "line": {
          "type": ["integer", "null"],
          "minimum": 1
        },
        "function": {
          "type": ["string", "null"]
        },
        "exact": {
          "type": "boolean"
        }
      }
    },
    "retrieval_candidate_source": {
      "type": "string",
      "enum": [
        "exact_seed",
        "file_path_seed",
        "text_evidence",
        "lexical_fts",
        "symbol_lookup",
        "vector_binary",
        "vector_rerank",
        "vector_semantic",
        "nuance_rescue",
        "graph_neighbor",
        "path_evidence",
        "no_proof_fallback",
        "diagnostic",
        "unknown"
      ]
    },
    "retrieval_proof_status": {
      "type": "string",
      "enum": [
        "proof_path_found",
        "no_proof_path_found",
        "not_graph_proof",
        "candidate_only",
        "diagnostic_only",
        "stale_or_foreign_db",
        "unknown"
      ]
    },
    "retrieval_verification_status": {
      "type": "string",
      "enum": [
        "unverified",
        "needs_graph_verification",
        "graph_verified",
        "no_proof_path_found",
        "not_graph_proof",
        "candidate_only",
        "diagnostic_only",
        "stale_or_foreign_db",
        "omitted",
        "truncated",
        "unknown"
      ]
    },
    "vector_embedding_source": {
      "type": "string",
      "enum": [
        "graph_entity",
        "text_evidence",
        "file_path_title",
        "snippet",
        "doc_comment",
        "signature",
        "unknown"
      ]
    },
    "retrieval_candidate_lifecycle_status": {
      "type": "string",
      "enum": ["fresh", "stale", "invalid", "unknown"]
    },
    "retrieval_candidate_lifecycle_binding": {
      "type": "object",
      "required": [
        "status",
        "db_passport_fingerprint",
        "repo_head",
        "scope_policy_hash",
        "embedding_model_id",
        "embedding_profile",
        "stale_reason"
      ],
      "additionalProperties": false,
      "properties": {
        "status": {
          "$ref": "#/$defs/retrieval_candidate_lifecycle_status"
        },
        "db_passport_fingerprint": {
          "type": ["string", "null"]
        },
        "repo_head": {
          "type": ["string", "null"]
        },
        "scope_policy_hash": {
          "type": ["string", "null"]
        },
        "embedding_model_id": {
          "type": ["string", "null"]
        },
        "embedding_profile": {
          "type": ["string", "null"]
        },
        "stale_reason": {
          "type": ["string", "null"]
        }
      }
    },
    "retrieval_candidate": {
      "type": "object",
      "required": [
        "candidate_id",
        "candidate_source",
        "file_id",
        "path",
        "entity_id",
        "span",
        "evidence_role",
        "proof_status",
        "graph_proof",
        "claimable",
        "diagnostic_only",
        "score",
        "rank",
        "matched_seeds",
        "requires_graph_verification",
        "verification_status",
        "reason",
        "omitted",
        "truncated"
      ],
      "additionalProperties": true,
      "properties": {
        "candidate_id": {
          "type": "string",
          "minLength": 1
        },
        "candidate_source": {
          "$ref": "#/$defs/retrieval_candidate_source"
        },
        "candidate_sources": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/retrieval_candidate_source"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "embedding_source": {
          "anyOf": [
            {
              "$ref": "#/$defs/vector_embedding_source"
            },
            {
              "type": "null"
            }
          ]
        },
        "file_id": {
          "type": ["string", "null"]
        },
        "path": {
          "type": ["string", "null"]
        },
        "entity_id": {
          "type": ["string", "null"]
        },
        "span": {
          "anyOf": [
            {
              "$ref": "#/$defs/source_span"
            },
            {
              "type": "null"
            }
          ]
        },
        "source_span_missing_reason": {
          "type": ["string", "null"]
        },
        "matched_query_text": {
          "type": ["string", "null"]
        },
        "matched_token": {
          "type": ["string", "null"]
        },
        "matched_tokens": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "rescue_reason": {
          "type": ["string", "null"]
        },
        "rescue_kinds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "evidence_role": {
          "$ref": "#/$defs/evidence_role"
        },
        "proof_status": {
          "$ref": "#/$defs/retrieval_proof_status"
        },
        "graph_proof": {
          "type": "boolean"
        },
        "claimable": {
          "type": "boolean"
        },
        "claimable_for_text": {
          "type": "boolean"
        },
        "claimable_for_graph": {
          "type": "boolean"
        },
        "diagnostic_only": {
          "type": "boolean"
        },
        "score": {
          "type": ["number", "null"]
        },
        "rank": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "embedding_model_id": {
          "type": ["string", "null"]
        },
        "embedding_dim": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "embedding_profile": {
          "type": ["string", "null"]
        },
        "chunk_id": {
          "type": ["string", "null"]
        },
        "chunk_kind": {
          "type": ["string", "null"]
        },
        "matched_seeds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "requires_graph_verification": {
          "type": "boolean"
        },
        "verification_status": {
          "$ref": "#/$defs/retrieval_verification_status"
        },
        "lifecycle_binding": {
          "anyOf": [
            {
              "$ref": "#/$defs/retrieval_candidate_lifecycle_binding"
            },
            {
              "type": "null"
            }
          ]
        },
        "reason": {
          "type": "string"
        },
        "omitted": {
          "type": "boolean"
        },
        "truncated": {
          "type": "boolean"
        },
        "source_labels": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "ranking_features": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "exact_seed_match": {
              "type": "boolean"
            },
            "file_path_match": {
              "type": "boolean"
            },
            "text_evidence_match": {
              "type": "boolean"
            },
            "symbol_entity_match": {
              "type": "boolean"
            },
            "graph_proximity": {
              "type": "boolean"
            },
            "source_role_compatible": {
              "type": "boolean"
            },
            "lifecycle_claimable": {
              "type": "boolean"
            },
            "proof_available": {
              "type": "boolean"
            }
          }
        },
        "candidate_cap": {
          "type": "integer",
          "minimum": 1
        },
        "candidate_cap_policy": {
          "type": "string"
        },
        "metadata": {
          "type": "object",
          "additionalProperties": true
        }
      }
    },
    "entity_ref": {
      "type": "object",
      "required": ["id", "name"],
      "additionalProperties": true,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "qualified_name": {
          "type": "string"
        },
        "kind": {
          "type": "string"
        },
        "file": {
          "type": "string"
        },
        "source_role": {
          "$ref": "#/$defs/evidence_role"
        },
        "source_spans": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/source_span"
          }
        }
      }
    },
    "evidence_role": {
      "type": "string",
      "enum": ["production", "test", "mock", "mixed", "text_evidence", "unknown"]
    },
    "exactness": {
      "type": "string",
      "enum": [
        "compiler_verified",
        "lsp_verified",
        "parser_verified",
        "static_heuristic",
        "inferred",
        "unknown"
      ]
    },
    "proof_edge": {
      "type": "object",
      "required": ["relation", "source", "target", "evidence_role"],
      "additionalProperties": true,
      "properties": {
        "edge_id": {
          "type": "string"
        },
        "relation": {
          "type": "string",
          "minLength": 1
        },
        "source": {
          "$ref": "#/$defs/entity_ref"
        },
        "target": {
          "$ref": "#/$defs/entity_ref"
        },
        "exactness": {
          "$ref": "#/$defs/exactness"
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "evidence_role": {
          "$ref": "#/$defs/evidence_role"
        },
        "classification_reason": {
          "type": "string"
        },
        "classification_source": {
          "type": "string"
        },
        "source_spans": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/source_span"
          }
        }
      }
    },
    "snippet": {
      "type": "object",
      "required": ["file", "lines", "text"],
      "additionalProperties": true,
      "properties": {
        "file": {
          "type": "string",
          "minLength": 1
        },
        "lines": {
          "type": "string",
          "minLength": 1
        },
        "text": {
          "type": "string"
        },
        "reason": {
          "type": "string"
        },
        "evidence_role": {
          "$ref": "#/$defs/evidence_role"
        }
      }
    }
  }
}
