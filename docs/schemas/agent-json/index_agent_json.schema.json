{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://codegraph.local/schemas/agent-json/index_agent_json.schema.json",
  "title": "index_agent_json",
  "type": "object",
  "required": [
    "schema_name",
    "schema_version",
    "status",
    "command",
    "repo",
    "db",
    "lifecycle",
    "claimable",
    "diagnostic_only",
    "truncation",
    "result_count",
    "limit",
    "omitted_count",
    "warnings",
    "errors",
    "timings",
    "summary"
  ],
  "additionalProperties": true,
  "properties": {
    "schema_name": {
      "const": "index_agent_json"
    },
    "schema_version": {
      "const": 1
    },
    "status": {
      "$ref": "common.schema.json#/$defs/status"
    },
    "command": {
      "const": "index"
    },
    "repo": {
      "$ref": "common.schema.json#/$defs/repo"
    },
    "db": {
      "$ref": "common.schema.json#/$defs/db"
    },
    "lifecycle": {
      "$ref": "common.schema.json#/$defs/lifecycle_summary"
    },
    "claimable": {
      "type": "boolean"
    },
    "diagnostic_only": {
      "type": "boolean"
    },
    "truncation": {
      "$ref": "common.schema.json#/$defs/truncation"
    },
    "result_count": {
      "const": 1
    },
    "limit": {
      "const": 1
    },
    "omitted_count": {
      "const": 0
    },
    "warnings": {
      "$ref": "common.schema.json#/$defs/bounded_messages"
    },
    "errors": {
      "$ref": "common.schema.json#/$defs/bounded_messages"
    },
    "timings": {
      "$ref": "common.schema.json#/$defs/timings"
    },
    "telemetry": {
      "$ref": "common.schema.json#/$defs/telemetry_truth"
    },
    "summary": {
      "type": "object",
      "required": ["repo", "build_mode"],
      "additionalProperties": true,
      "properties": {
        "repo": {
          "type": "string"
        },
        "build_mode": {
          "type": "string"
        },
        "files_indexed": {
          "type": "integer",
          "minimum": 0
        },
        "files_changed": {
          "type": "integer",
          "minimum": 0
        },
        "files_skipped": {
          "type": "integer",
          "minimum": 0
        },
        "entities": {
          "type": "integer",
          "minimum": 0
        },
        "edges": {
          "type": "integer",
          "minimum": 0
        },
        "duration_ms": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "vector_index": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "generated_total_chunks": {
          "type": "integer",
          "minimum": 0
        },
        "persisted_total_chunks": {
          "type": "integer",
          "minimum": 0
        },
        "chunk_cap": {
          "type": "integer",
          "minimum": 0
        },
        "chunk_cap_applied": {
          "type": "boolean"
        },
        "input_order_cap": {
          "type": "boolean"
        },
        "actual_index_file_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "index_artifact_format": {
          "enum": ["pretty_json", "compact_json", "binary", "sqlite_table", "in_memory"]
        },
        "estimated_f32_payload_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "estimated_f32_payload_dim": {
          "type": "integer",
          "minimum": 0
        },
        "estimated_f32_payload_count": {
          "type": "integer",
          "minimum": 0
        },
        "stores_chunk_text": {
          "type": "boolean"
        },
        "stores_chunk_metadata": {
          "type": "boolean"
        },
        "stores_full_source_body": {
          "type": "boolean"
        },
        "vector_payload_compression": {
          "enum": ["none", "diagnostic", "real"]
        },
        "estimated_vector_bytes_deprecated_alias_for": {
          "const": "estimated_f32_payload_bytes"
        },
        "persisted_chunks_by_top_level_dir": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          }
        },
        "persisted_chunks_by_file_kind": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          }
        },
        "persisted_chunks_by_source_kind": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          }
        },
        "omitted_by_cap": {
          "type": "integer",
          "minimum": 0
        },
        "omitted_by_bucket_limit": {
          "type": "integer",
          "minimum": 0
        },
        "omitted_low_signal": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  }
}
