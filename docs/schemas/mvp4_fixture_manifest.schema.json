        "start_column": {
          "type": "integer",
          "minimum": 1
        },
        "end_line": {
          "type": "integer",
          "minimum": 1
        },
        "end_column": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "exactness": {
      "enum": [
        "exact",
        "derived_with_provenance",
        "heuristic",
        "unsupported",
        "unknown"
