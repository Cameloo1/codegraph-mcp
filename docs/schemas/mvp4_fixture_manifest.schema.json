        },
        "why_not_proof": {
          "type": "string"
        }
      }
    },
    "expected_validation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "classification",
        "severity",
        "rule_id",
        "hard_interrupt_available",
