  "$id": "https://codegraph.local/schemas/language_coverage_matrix.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "generated_at": {
      "type": "string"
    },
    "languages": {
      "items": {
        "$ref": "#/$defs/language"
      },
      "type": "array"
    },
    "schema_version": {
      "minimum": 1,
      "type": "integer"
    }
  },
  "required": [
    "schema_version",
    "generated_at",
    "languages"
  ],
  "title": "CodeGraph Language Coverage Matrix",
  "type": "object"
}
